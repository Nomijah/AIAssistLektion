@host = http://localhost:5080

### Get all products
GET {{host}}/api/products
Accept: application/json

### Get one product
GET {{host}}/api/products/1
Accept: application/json

### Create a product
POST {{host}}/api/products
Content-Type: application/json

{
  "name": "Webcam",
  "description": "1080p USB webcam",
  "price": 799,
  "stockQuantity": 12
}

### Delete a product (change id if needed)
DELETE {{host}}/api/products/4

### Invalid: empty name
POST {{host}}/api/products
Content-Type: application/json

{
  "name": "",
  "price": 199,
  "stockQuantity": 3
}

### Invalid: negative price
POST {{host}}/api/products
Content-Type: application/json

{
  "name": "Invalid product",
  "price": -1,
  "stockQuantity": 3
}

### Invalid: negative stock quantity
POST {{host}}/api/products
Content-Type: application/json

{
  "name": "Invalid product",
  "price": 199,
  "stockQuantity": -1
}
